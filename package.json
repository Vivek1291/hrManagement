{
  "name": "hr-management-ui",
  "version": "0.1.0",
  "description": "A fully API-configurable HR management UI for React, styled with Tailwind CSS. Configure tabs, routes, API endpoints, tables, forms, actions and permissions — employees, attendance, leaves, holidays, payroll, payslips and more.",
  "license": "MIT",
  "author": "Vivek Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivek1291/hrmanagement.git"
  },
  "keywords": [
    "react",
    "hr",
    "hrms",
    "human-resources",
    "employees",
    "payroll",
    "payslips",
    "leave-management",
    "attendance",
    "admin",
    "configurable",
    "dashboard",
    "tailwind",
    "tailwindcss",
    "holidays",
    "hrm",
    "hris"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o dist/styles.css --minify",
    "dev": "vite --config examples/demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
